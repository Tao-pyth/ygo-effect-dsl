{
  "authority": {
    "analytics": "immutable_snapshot",
    "jobs": "sqlite_job_catalog",
    "legality_and_timing": "ocgcore_worker",
    "renderer": "non_authoritative",
    "search_and_replay": "existing_worker_subprocess"
  },
  "limits": {
    "max_request_bytes": 262144,
    "max_response_bytes": 4194304,
    "request_id_max_chars": 128
  },
  "methods": {
    "analytics.compare": {
      "payload_fields": ["request"],
      "worker_start_allowed": false
    },
    "analytics.export.enqueue": {
      "payload_fields": ["format", "idempotency_key", "priority", "source", "source_kind"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "analytics.query": {
      "payload_fields": ["request"],
      "worker_start_allowed": false
    },
    "card.get": {
      "payload_fields": ["query"],
      "worker_start_allowed": false
    },
    "deck.card_options": {
      "payload_fields": ["deck_id"],
      "renderer_path_input": false,
      "source": "registered_deck_and_verified_japanese_card_presentation",
      "worker_start_allowed": false
    },
    "deck.catalog": {
      "payload_fields": [],
      "worker_start_allowed": false
    },
    "deck.import_ydk": {
      "native_file_picker": true,
      "payload_fields": [],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.metadata.get": {
      "payload_fields": ["deck_id"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.metadata.update": {
      "payload_fields": ["deck_id", "display_name", "tags"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.profile.archive": {
      "payload_fields": ["deck_profile_id"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.profile.create": {
      "payload_fields": ["deck_id", "display_name", "rules"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.profile.get": {
      "payload_fields": ["deck_profile_id"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.profile.list": {
      "payload_fields": ["deck_id", "include_archived"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.profile.update": {
      "payload_fields": ["deck_profile_id", "display_name", "rules"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "deck.register_inline": {
      "payload_fields": ["extra", "main", "name", "side"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "job.cancel": {
      "payload_fields": ["job_id"],
      "worker_start_allowed": false
    },
    "job.enqueue_replay_verification": {
      "payload_fields": ["idempotency_key", "priority", "search_job_id"],
      "source": "committed_search_job_artifacts",
      "verification_job_kind": "replay",
      "worker_start_allowed": false
    },
    "job.enqueue_search": {
      "payload_fields": ["deck_id", "experiment", "idempotency_key", "priority"],
      "preflight_required": true,
      "worker_start_allowed": false
    },
    "job.result": {
      "payload_fields": ["job_id"],
      "renderer_path_input": false,
      "requires_committed_artifacts": ["route-dsl", "search-run-report"],
      "worker_start_allowed": false
    },
    "job.status": {
      "payload_fields": ["job_id"],
      "worker_start_allowed": false
    },
    "profile.clone": {
      "payload_fields": ["name", "profile_id", "rules"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "profile.get": {
      "payload_fields": ["profile_id"],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "profile.list": {
      "payload_fields": [],
      "renderer_path_input": false,
      "worker_start_allowed": false
    },
    "scenario.compose_search": {
      "configuration_fields": [
        "interruption_card_code",
        "max_depth",
        "max_nodes",
        "max_seconds",
        "opening_hand",
        "pool_size",
        "preference_profile_id",
        "scenario_preset_id",
        "seed",
        "strategy"
      ],
      "parallel_policy": {
        "default_pool_size": 1,
        "max_pool_size": 8,
        "schema_version": "parallel-search-policy-v1"
      },
      "payload_fields": ["configuration", "deck_id"],
      "renderer_path_input": false,
      "renderer_rule_inference": false,
      "scenario_presets": [
        {
          "id": "terminal_board_min_monster_v1",
          "objective": "maximize_terminal_board",
          "evaluator": "real_core_board_count/1",
          "success_predicate": "real_core_min_monster_count/1"
        }
      ],
      "worker_start_allowed": false
    },
    "scenario.preflight": {
      "payload_fields": ["deck_id", "experiment"],
      "worker_start_allowed": false
    },
    "settings.get": {
      "payload_fields": [],
      "source": "versioned_desktop_settings",
      "worker_start_allowed": false
    },
    "settings.reset": {
      "payload_fields": ["safe_mode"],
      "source": "versioned_desktop_settings",
      "worker_start_allowed": false
    },
    "settings.update": {
      "payload_fields": ["settings"],
      "source": "versioned_desktop_settings",
      "worker_start_allowed": false
    },
    "system.describe": {
      "payload_fields": [],
      "worker_start_allowed": false
    },
    "system.external_asset_status": {
      "payload_fields": [],
      "source": "verified_external_asset_setup_status",
      "worker_start_allowed": false
    }
  },
  "request": {
    "fields": ["method", "payload", "request_id", "version"],
    "path_inputs": "forbidden_use_catalog_id_or_native_picker"
  },
  "response_schema_version": "desktop-bridge-response-v1",
  "schema_version": "desktop-bridge-v1",
  "security": {
    "generic_python_object": false,
    "local_rest_api": false,
    "public_python_methods": ["invoke"],
    "remote_content": false
  }
}
